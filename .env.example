# Supabase — project settings → API. The anon key is safe to ship to the
# client (RLS gates every table); the service role key is NOT and never
# appears here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Without these two set, the app runs in local-only mode: everything works,
# stored on-device, and syncing starts once they exist.

# Where /api/dump lives (the Vercel deployment). Web builds served from that
# same deployment can leave this unset and use the relative path; native
# builds need the absolute URL. Falls back to local parsing when unreachable.
EXPO_PUBLIC_API_URL=https://your-deployment.vercel.app

# ---------------------------------------------------------------------------
# Server-side only. These belong in Vercel's environment variables, never in
# this file and never in the app bundle — nothing here is EXPO_PUBLIC_.
#
# The parser uses whichever is set (OpenRouter wins if both are). With
# neither, Found quietly falls back to its local parser.
#
#   OPENROUTER_API_KEY=sk-or-v1-...
#   ANTHROPIC_API_KEY=sk-ant-...
#
# Optional model override. Defaults: anthropic/claude-sonnet-5 on OpenRouter
# (~half a cent per capture), claude-opus-5 direct. anthropic/claude-haiku-4.5
# is the cheaper OpenRouter option.
#   DUMP_MODEL=anthropic/claude-sonnet-5
