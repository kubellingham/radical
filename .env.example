# Supabase — project settings → API. The anon key is safe to ship to the
# client (RLS gates every table); the service role key is NOT and never
# appears here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Without these two set, the app runs in local-only mode: everything works,
# stored on-device, and syncing starts once they exist.

# Where /api/dump lives (the Vercel deployment). Web builds served from that
# same deployment can leave this unset and use the relative path; native
# builds need the absolute URL. Falls back to local parsing when unreachable.
EXPO_PUBLIC_API_URL=https://your-deployment.vercel.app
